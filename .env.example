# Copy this file to ".env" and fill in your real values. NEVER commit .env.

# NVIDIA API (one key and one URL for all three tiers)
NVIDIA_API_KEY= #12345#
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model IDs (exact strings from each model's code sample on build.nvidia.com)
SMALL_MODEL=nvidia/nemotron-3.5-bolt-e4b
MEDIUM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LARGE_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# SIMULATED price per 1,000 tokens in USD (the API is free, so we assign
# prices to compare cost). We choose these numbers in the next action.
SMALL_IN_COST_PER_1K=0.0001
SMALL_OUT_COST_PER_1K=0.0002
MEDIUM_IN_COST_PER_1K=0.0004
MEDIUM_OUT_COST_PER_1K=0.0008
LARGE_IN_COST_PER_1K=0.0020
LARGE_OUT_COST_PER_1K=0.0040


# Free tier rate limit (requests per minute)
MAX_RPM=40

# Tiers used by labeling, routers, evaluation and the API (cheapest first)
ACTIVE_TIERS=small,large

# API security: clients must send this in the X-API-Key header (generate a long random string)
APP_API_KEY=change-me-to-a-long-random-string
RATE_LIMIT_PER_MIN=30
# Where the Streamlit UI finds the API (docker-compose overrides this)
API_URL=http://localhost:8000

# Daily budget cap (API refuses LLM calls beyond these, per UTC day)
DAILY_CALL_LIMIT=500
DAILY_COST_LIMIT=1.00
# Streamlit login password (leave empty to disable the login on your own PC)
UI_PASSWORD=change-me
